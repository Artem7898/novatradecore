# Run make init to generate a private .env with random credentials.
# Keep .env out of version control and rotate credentials before changing environments.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
INGEST_API_TOKENS={}
INGEST_RATE_LIMIT=300
INGEST_RATE_WINDOW_SECONDS=60
DATABASE_NAME=novatrade
DATABASE_USER=nova
DATABASE_PASSWORD=
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_WAIT_TIMEOUT=60
# Production-only bootstrap/migration credentials; runtime web never receives these.
POSTGRES_ADMIN_PASSWORD=
MIGRATION_DATABASE_USER=nova_migrator
MIGRATION_DATABASE_PASSWORD=
REDIS_PASSWORD=
REDIS_URL=
# Enable only behind an ingress that strips/replaces X-Forwarded-Proto.
TRUST_PROXY_HEADERS=false
# Production settings redirect normal HTTP requests to HTTPS.
SECURE_SSL_REDIRECT=true
